# Copy this file to .env for local runs. On Render/Vercel, set these as environment variables instead.

# Required: Google Gemini API key from https://aistudio.google.com/apikey
# For patient data, turn on billing for the key's Google Cloud project: on the free tier Google may use
# what you send to improve its products, and people may review it.
GEMINI_API_KEY=

# Required: password doctors type to use the scanner. At least 10 characters (12+ recommended); the
# deployed site refuses to run the doctor side without it.
APP_PASSWORD=

# Required: long random string (32+ characters) used to sign patient links and sessions. Keep it secret and never change it,
# or old patient links stop working. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=

# Optional: models that read prescriptions, tried in order (Pro is best but needs billing; Flash works free)
GEMINI_MODELS=gemini-pro-latest,gemini-3-flash-preview,gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash

# Optional: natural voice for patients (same key). Set NATURAL_VOICE=off to use the phone's own voice instead.
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
NATURAL_VOICE=on

# Optional: how many days a patient link stays valid (default 30)
LINK_DAYS=30

# Optional: port (hosts set this automatically)
PORT=3000
