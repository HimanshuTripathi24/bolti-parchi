# Copy this file to .env for local runs. On Render/other hosts, set these as environment variables instead.

# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required: password doctors type to use the scanner (stops strangers from spending your API credits)
APP_PASSWORD=

# Required: long random string used to sign patient links. Keep it secret and never change it,
# or old patient links stop working. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=

# Optional: Google Cloud Text-to-Speech API key. When set, patients hear a natural Hindi/English voice
# and doctors can download an MP3 to send on WhatsApp. Without it, the patient's phone voice is used.
GOOGLE_TTS_API_KEY=

# Optional: model used to read prescriptions (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Optional: how many days a patient link stays valid (default 30)
LINK_DAYS=30

# Optional: port (hosts like Render set this automatically)
PORT=3000
